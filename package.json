{
  "name": "vue-website-template",
  "version": "1.0.0",
  "description": "Template for websites build with: Vue, Nuxt, Vuetify, Nuxt, i18, eslint, prettier",
  "author": "Christian Wenzel",
  "private": true,
  "scripts": {
    "dev": "nuxt",
    "build": "nuxt build",
    "start": "nuxt start",
    "analyze": "nuxt build --analyze",
    "generate": "nuxt generate",
    "test": "node --test test/*.js",
    "lint": "eslint --ext .js,.vue --ignore-path .gitignore .",
    "lint:prod": "NODE_ENV='production' eslint --ext .js,.vue --ignore-path .gitignore .",
    "lint:fix": "eslint --fix . --ext .js,.vue",
    "format": "prettier --write \"**/*.{js,vue}\""
  },
  "dependencies": {
    "@nuxtjs/axios": "^5.3.6",
    "@nuxtjs/pwa": "^3.0.0-0",
    "core-js": "^3.12.0",
    "graphql": "^16.0.1",
    "graphql-tag": "^2.10.3",
    "lru-cache": "^6.0.0",
    "minify-css-string": "^1.0.0",
    "nuxt": "^2.15.3",
    "nuxt-i18n": "^6.28.1",
    "vee-validate": "^3.4.5",
    "vue": "^2.6.14",
    "vue-fragment": "1.5.2",
    "vuetify": "^2.4.11",
    "vuex": "^3.5.1",
    "vuex-persistedstate": "^4.1.0"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.14.7",
    "@nuxt/types": "^2.15.8",
    "@nuxtjs/eslint-config": "^8.0.0",
    "@nuxtjs/eslint-module": "^3.0.2",
    "@nuxtjs/vuetify": "^1.12.1",
    "@types/jest": "^27.0.2",
    "@vue/cli-plugin-babel": "^4.5.14",
    "@vue/cli-plugin-eslint": "^4.5.14",
    "@vue/eslint-config-prettier": "^6.0.0",
    "babel-eslint": "^10.1.0",
    "eslint": "^7.32.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-nuxt": "^3.1.0",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-simple-import-sort": "^7.0.0",
    "eslint-plugin-vue": "^8.2.0",
    "jest": "^27.3.1",
    "prettier": "^2.4.1"
  }
}
