{
  "name": "vue-website-template",
  "version": "1.0.0",
  "description": "Template for websites build with: Vue, Nuxt, Vuetify, Nuxt, i18, eslint, prettier",
  "author": "Christian Wenzel",
  "private": true,
  "scripts": {
    "postinstall": "nuxt prepare",
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,ts,vue}\""
  },
  "dependencies": {
    "@nuxtjs/i18n": "^10.6.0",
    "core-js": "^3.12.0",
    "nuxt": "^4.6.0",
    "vue": "^3.5.43",
    "vuetify": "^3.13.6",
    "vuetify-nuxt-module": "^1.0.0-rc.6"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "prettier": "^3.9.9",
    "sass": "^1.105.1",
    "typescript": "~6.0.3"
  }
}
